{
  "version": "v1",
  "created_at": "2026-11-09",
  "annotation_policy": "标准答案由人工按 evidence/official/ 与 data/docs/official-*.md 原文逐条标注；LLM 不参与出题、不参与判卷。判卷只做确定性字符串/规则匹配，见 tools/score_eval.py。",
  "scope": "inter-context conflict only（依据 arXiv:2403.08319 的三类冲突划分，本项目不处理 context-memory / intra-memory）",
  "cases": [
    {
      "id": "Q01",
      "type": "single_source",
      "question": "省赛作品提交截止是哪一天？",
      "must_include": [
        "2026-11-18",
        "15:00"
      ],
      "must_not_include": [
        "2026-12-27",
        "24:00",
        "2026-10-31"
      ],
      "gold_doc_ids": [
        "official-01",
        "official-03",
        "official-04"
      ],
      "conflict_doc_ids": [],
      "expected_refused": false,
      "annotation_source": "official-01「提交截止时间：2026年11月18日15:00」；official-03「请于11月18日15:00前」；official-04「截止时间：2026-11-18 15:00:00」"
